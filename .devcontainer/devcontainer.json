{
  "name": "StudyMedicineUKNigeria",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Site preview", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "nohup php artisan serve --host=0.0.0.0 --port=8000 > /tmp/serve.log 2>&1 &",
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
