# Copy to ~/apps/smukn/shared/.env on the server and fill in. Never commit the filled file.
APP_NAME="Study Medicine UK Nigeria"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://studymedicineuknigeria.com
APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=private

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=info@studymedicineuknigeria.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@studymedicineuknigeria.com"
MAIL_FROM_NAME="Study Medicine UK Nigeria"

STRIPE_KEY=                   # pk_live_...
STRIPE_SECRET=                # sk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (endpoint: https://studymedicineuknigeria.com/webhooks/stripe)
STRIPE_ADAPTIVE_PRICING=false

SITE_WHATSAPP=                # E.164 digits without +, e.g. 2348000000000 (blank hides WhatsApp links)
SITE_LEGAL_NAME=              # registered company name
SITE_COMPANY_NUMBER=
SITE_ADDRESS=
SITE_PUBLISH_UNVERIFIED=false # keep false: unverified facts stay hidden in production
